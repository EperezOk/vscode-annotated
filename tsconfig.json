{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "types": ["mocha"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "e2e", "**/*.svelte.test.ts"]
}
