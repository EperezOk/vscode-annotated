{
  "name": "vscode-annotated",
  "displayName": "Annotated",
  "description": "Annotate a codebase with grouped, shareable Markdown annotations.",
  "version": "0.0.0",
  "publisher": "eperezok",
  "license": "MIT",
  "engines": { "vscode": "^1.106.0", "node": ">=20.19" },
  "categories": ["Other"],
  "activationEvents": [],
  "browser": "./dist/web/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        { "id": "annotated", "title": "Annotated", "icon": "media/icon.svg" }
      ],
      "secondarySidebar": [
        { "id": "annotated-detail", "title": "Annotated Detail", "icon": "media/icon.svg" }
      ]
    },
    "views": {
      "annotated": [
        { "type": "webview", "id": "annotated.sidebar", "name": "Annotations" }
      ],
      "annotated-detail": [
        { "type": "webview", "id": "annotated.detail", "name": "Detail" }
      ]
    },
    "commands": [
      { "command": "annotated.ping", "title": "Annotated: Ping" },
      { "command": "annotated.createAnnotation", "title": "Annotated: Create Annotation" }
    ],
    "keybindings": [
      {
        "command": "annotated.createAnnotation",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a",
        "when": "editorTextFocus && editorHasSelection"
      }
    ],
    "configuration": {
      "title": "Annotated",
      "properties": {
        "annotated.tags": {
          "type": "array",
          "default": [],
          "description": "Tag palette: each tag has a name and a display color.",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "color": { "type": "string" }
            }
          }
        },
        "annotated.authorName": {
          "type": "string",
          "description": "Display name used as the author of annotation groups you create."
        },
        "annotated.authorEmail": {
          "type": "string",
          "default": "",
          "description": "Email used to attribute your annotation comments (canonical identity)."
        }
      }
    }
  },
  "scripts": {
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "package": "node esbuild.mjs --production",
    "check-types": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test:unit": "vitest run",
    "test:integration": "npm run compile && vscode-test-web --browserType=chromium --extensionDevelopmentPath=. --extensionTestsPath=dist/web/test/suite/index.js --headless --quality=stable test-workspace",
    "serve:web": "vscode-test-web --browserType=none --extensionDevelopmentPath=. --port=3000 test-workspace",
    "test:e2e": "playwright test",
    "test": "npm run check-types && npm run test:unit && npm run test:integration && npm run test:e2e",
    "start": "vscode-test-web --browserType=chromium --extensionDevelopmentPath=.",
    "vscode:prepublish": "npm run package"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.11.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@lezer/highlight": "^1.2.3",
    "dompurify": "^3.4.7",
    "markdown-it": "^14.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.3.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/mocha": "^10.0.7",
    "@types/node": "^25.9.1",
    "@types/vscode": "^1.106.0",
    "@vscode/test-web": "^0.0.80",
    "esbuild": "^0.28.0",
    "esbuild-svelte": "^0.9.5",
    "jsdom": "^29.1.1",
    "mocha": "^11.7.6",
    "svelte": "^5.56.0",
    "svelte-preprocess": "^6.0.5",
    "typescript": "^5.9.2",
    "vitest": "^4.1.7"
  }
}
